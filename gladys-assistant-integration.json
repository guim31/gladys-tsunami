{
  "manifest_version": 1,
  "type": "device",
  "name": "Tsunami Alerts (NOAA)",
  "description": {
    "en": "Official NOAA tsunami messages (NTWC, PTWC) for your coast: level, earthquake, arrival time.",
    "fr": "Messages tsunami officiels de la NOAA (NTWC, PTWC) pour votre côte : niveau, séisme, arrivée.",
    "de": "Offizielle Tsunami-Meldungen der NOAA (NTWC, PTWC) für deine Küste: Stufe, Erdbeben, Ankunft.",
    "es": "Mensajes oficiales de tsunami de la NOAA (NTWC, PTWC) para su costa: nivel, sismo, llegada."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-tsunami:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-tsunami/main/cover.png",
  "categories": ["environment", "security"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your coast",
        "fr": "Votre côte",
        "de": "Deine Küste",
        "es": "Su costa"
      },
      "description": {
        "en": "Tsunami messages of NOAA's two warning centers, NTWC and PTWC. The region is deduced from your house (or coordinates), never sent. Save, then create the device in the Discover tab.",
        "fr": "Messages tsunami des deux centres d'alerte de la NOAA, NTWC et PTWC. La région est déduite de votre maison (ou de coordonnées), jamais envoyée. Enregistrez, puis créez l'appareil dans l'onglet Découverte.",
        "de": "Tsunami-Meldungen der beiden Warnzentren der NOAA, NTWC und PTWC. Die Region wird aus deinem Haus (oder Koordinaten) abgeleitet, nie gesendet. Speichere und lege dann das Gerät im Tab „Entdecken“ an.",
        "es": "Mensajes de tsunami de los dos centros de alerta de la NOAA, NTWC y PTWC. La región se deduce de su casa (o de coordenadas), nunca se envía. Guarde y cree el dispositivo en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-tsunami/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "region",
      "type": "select",
      "label": {
        "en": "Followed region",
        "fr": "Région suivie",
        "de": "Verfolgte Region",
        "es": "Región seguida"
      },
      "description": {
        "en": "Automatic: from the home. Choose by hand if your coast is on a border, or far from the US.",
        "fr": "Automatique : d'après la maison. Choisissez à la main si votre côte est en limite, ou loin des États-Unis.",
        "de": "Automatisch: nach dem Zuhause. Wähle von Hand, wenn deine Küste an einer Grenze oder fern der USA liegt.",
        "es": "Automática: según la casa. Elija a mano si su costa está en un límite o lejos de EE. UU."
      },
      "required": false,
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic (from the home)",
            "fr": "Automatique (d'après la maison)",
            "de": "Automatisch (nach dem Zuhause)",
            "es": "Automática (según la casa)"
          }
        },
        {
          "value": "alaska_west_coast",
          "label": {
            "en": "Alaska, BC and US West Coast (NTWC)",
            "fr": "Alaska, C.-B. et côte ouest des É.-U. (NTWC)",
