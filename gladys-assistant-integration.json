  "actions": [
    {
      "key": "check_now",
      "label": {
        "en": "Show the message in effect",
        "fr": "Afficher le message en cours",
        "de": "Aktuelle Meldung anzeigen",
        "es": "Mostrar el mensaje en vigor"
      },
      "timeout_seconds": 60
    }
  ],
