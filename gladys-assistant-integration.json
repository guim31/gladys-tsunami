            "es": "Pacífico, mensajes internacionales (PTWC)"
          }
        }
      ]
    },
    {
      "key": "latitude",
      "type": "string",
      "label": {
        "en": "Home latitude",
        "fr": "Latitude de la maison",
        "de": "Breitengrad des Zuhauses",
        "es": "Latitud de la casa"
      },
      "description": {
        "en": "Leave both coordinates empty to use the location of your house in Gladys.",
        "fr": "Laissez les deux coordonnées vides pour utiliser la position de votre maison dans Gladys.",
        "de": "Lass beide Koordinaten leer, um den Standort deines Hauses in Gladys zu verwenden.",
        "es": "Deje ambas coordenadas vacías para usar la ubicación de su casa en Gladys."
      },
      "placeholder": {
        "en": "e.g. 19.7241",
        "fr": "ex. 14,6037",
        "de": "z. B. 19.7241",
        "es": "p. ej. 18.4655"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "longitude",
      "type": "string",
      "label": {
        "en": "Home longitude",
        "fr": "Longitude de la maison",
        "de": "Längengrad des Zuhauses",
        "es": "Longitud de la casa"
      },
      "description": {
        "en": "Decimal degrees, negative west of Greenwich.",
        "fr": "Degrés décimaux, négatifs à l'ouest de Greenwich.",
        "de": "Dezimalgrad, negativ westlich von Greenwich.",
        "es": "Grados decimales, negativos al oeste de Greenwich."
      },
      "placeholder": {
        "en": "e.g. -155.0868",
        "fr": "ex. -61,0588",
        "de": "z. B. -155.0868",
        "es": "p. ej. -66.1057"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de mise à jour",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "Unchanged lists answer 304 Not Modified: a reading every minute stays light.",
        "fr": "Les listes inchangées répondent 304 Not Modified : une lecture par minute reste légère.",
        "de": "Unveränderte Listen antworten 304 Not Modified: eine Abfrage pro Minute bleibt leicht.",
        "es": "Las listas sin cambios responden 304 Not Modified: una lectura por minuto sigue siendo ligera."
      },
      "required": false,
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
