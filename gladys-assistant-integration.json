        },
        {
          "value": "puerto_rico_vi",
          "label": {
            "en": "Puerto Rico and Virgin Islands (PTWC)",
            "fr": "Porto Rico et îles Vierges (PTWC)",
            "de": "Puerto Rico und Jungferninseln (PTWC)",
            "es": "Puerto Rico e Islas Vírgenes (PTWC)"
          }
        },
        {
          "value": "caribbean",
          "label": {
            "en": "Caribbean, international messages (PTWC)",
            "fr": "Caraïbes, messages internationaux (PTWC)",
